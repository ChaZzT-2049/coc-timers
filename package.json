{
  "name": "coc-timers",
  "private": true,
  "description": "PWA de timers de mejoras de Clash of Clans",
  "scripts": {
    "start": "npx --yes serve . -p 5173",
    "deploy:functions": "npx --yes firebase-tools@14 deploy --only functions,firestore --project coc-timers",
    "android:www": "node scripts/prepare-www.mjs",
    "android:sync": "npm run android:www && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
